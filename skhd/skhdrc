# ================================
# Window Focus (vim-style)
# ================================

alt - j : /opt/homebrew/bin/aerospace focus down
alt - k : /opt/homebrew/bin/aerospace focus up
alt - h : /opt/homebrew/bin/aerospace focus left
alt - l : /opt/homebrew/bin/aerospace focus right

# Focus displays directly
alt - s : /opt/homebrew/bin/aerospace focus-monitor left
alt - g : /opt/homebrew/bin/aerospace focus-monitor right


# ================================
# Layout Modifications
# ================================

shift + alt - r : /opt/homebrew/bin/aerospace flatten-workspace-tree
shift + alt - y : /opt/homebrew/bin/aerospace layout tiles vertical horizontal
shift + alt - x : /opt/homebrew/bin/aerospace layout tiles horizontal vertical

# toggle float (centered)
shift + alt - t : /opt/homebrew/bin/aerospace layout floating tiling


# ================================
# Window Size / Layout
# ================================

shift + alt - m : /opt/homebrew/bin/aerospace fullscreen
shift + alt - e : /opt/homebrew/bin/aerospace balance-sizes


# ================================
# Moving / Swapping Windows
# ================================

# swap
shift + alt - j : /opt/homebrew/bin/aerospace move down
shift + alt - k : /opt/homebrew/bin/aerospace move up
shift + alt - h : /opt/homebrew/bin/aerospace move left
shift + alt - l : /opt/homebrew/bin/aerospace move right

# warp (move + follow focus)
ctrl + alt - j : /opt/homebrew/bin/aerospace join-with down
ctrl + alt - k : /opt/homebrew/bin/aerospace join-with up
ctrl + alt - h : /opt/homebrew/bin/aerospace join-with left
ctrl + alt - l : /opt/homebrew/bin/aerospace join-with right


# ================================
# Move Windows Across Displays
# ================================

shift + alt - s : /opt/homebrew/bin/aerospace move-node-to-monitor left && sleep 0.1 && /opt/homebrew/bin/aerospace focus-monitor left
shift + alt - g : /opt/homebrew/bin/aerospace move-node-to-monitor right && sleep 0.1 && /opt/homebrew/bin/aerospace focus-monitor right


# ================================
# Workspace Setup & Management (Hyper Key)
# ================================
# Rebalance current space layout
hyper - r : /opt/homebrew/bin/aerospace balance-sizes

# Move active space left or right
hyper - left : /opt/homebrew/bin/aerospace workspace prev
hyper - right : /opt/homebrew/bin/aerospace workspace next


# ================================
# Yabai Service Control
# ================================

ctrl + alt - q : killall AeroSpace
ctrl + alt - s : open -a AeroSpace
ctrl + alt - r : /opt/homebrew/bin/aerospace reload-config

# ================================
# SketchyBar Control
# ================================

ctrl + alt - k : sketchybar --reload



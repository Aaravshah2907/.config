<?xml version="1.0" encoding="UTF-8"?>

<!-- Cosmere Theme for Yazi
     Inspired by Brandon Sanderson's Cosmere universe.

     Stormlight (Roshar):
       Honor Gold      #FFD700  — keywords, headings, find highlights
       Sapphire        #00BFFF  — types, storage
       Emerald         #50fa7b  — exec, inserted diff, raw inline
       Amber           #ffb86c  — markup bold/italic, function args, JSON depth 1/5
       Crimson         #ed8796  — deleted diff, invalid, punctuation
       Violet          #8989ff  — numbers, constants, deprecated

     Scadrial:
       Preservation Mist    #C8E8F5  — foreground / base text
       Preservation Glacial #5DA8CC  — lib functions, library constant, lib class
       Preservation Lavender #C3AEE8 — headings underline, diff filename
       Preservation Deep    #1A2A3A  — selection, line highlight
       Scadrial Night       #0D1B2A  — background

     Spren Accents:
       Honorspren Sky Blue  #00A8E8  — class names, entity names, storage type
       Cryptic Orchid       #DA70D6  — strings, tag names, punctuation accessors
       Cultivationspren Green #3CB371 — function names, tag attrs, diff inserted
       Inkspren Indigo      #8A2BE2  — JSON structure keys, variable language
       Willshaper Amethyst  #E040FB  — keywords, storage, important accents
       Ashspren Volcanic    #FF4500  — hard errors, message.error
-->

